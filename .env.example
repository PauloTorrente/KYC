# Copie para .env e preencha com valores reais. .env nunca deve ser commitado.

# ===== Banco de dados (Neon Postgres) =====
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ===== Pepper do hash de CPF (legado, tabela "cliente") =====
KYC_CPF_PEPPER=

# ===== Autenticacao (login fixo) =====
KYC_AUTH_USERNAME=admin
# Hash BCrypt da senha de login. Gere um novo, nao reutilize o de outro ambiente.
KYC_AUTH_PASSWORD_HASH=

# ===== JWT =====
# >= 32 bytes aleatorios. Gere com: openssl rand -base64 48
KYC_JWT_SECRET=
KYC_JWT_EXPIRATION_MINUTES=480

# ===== Servidor / CORS =====
SERVER_PORT=8080
KYC_CORS_ORIGINS=http://localhost:5173

# ===== Cloudflare R2 (documentos KYC - armazenamento, API compativel com S3) =====
KYC_S3_BUCKET=
KYC_S3_PRESIGNED_TTL_MINUTES=5
# Gere em dash.cloudflare.com > R2 > Manage API Tokens (permissao Object Read & Write
# no bucket acima). O Account ID aparece na barra lateral do dashboard da Cloudflare.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# ===== AWS Textract (OCR dos documentos) =====
# Continua na AWS (servico que so' existe la'; nao guarda arquivo nenhum, so' le' os
# bytes que a aplicacao envia). Prefira IAM role (producao) ou ~/.aws/credentials (dev
# local); so defina as duas linhas abaixo se realmente precisar de credenciais explicitas.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== Verificacao de documentos por IA (Claude/Anthropic) - opcional =====
# Gere em https://console.anthropic.com. Sem essa chave, o endpoint de verificacao
# por IA (/verificar-ia) fica desativado; o resto do KYC continua funcionando normal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
